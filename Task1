#include <stdio.h>
#include <stdlib.h>
#include <locale.h>

int main() {
    setlocale(LC_ALL, "");
    double a;
    int N;
    double S = 1.0;       // Початкова сума 
    double term = 1.0;    // Допоміжна змінна для поточного члена ряду

    // 1. Введення початкових даних
    printf("Введiть значення a: ");
    scanf("%lf", &a);

    printf("Введiть цiле число N (N >= 1): ");
    scanf("%d", &N);

    // Перевірка на правильність введення N
    if (N < 1) {
        printf("Помилка, N має бути  >= 1!\n");
        return 1;
    }

    // 2. Цикл обчислення суми ряду від 1 до N
    for (int n = 1; n <= N; n++) {
        if (n == 1) {
            term = a; // Перший доданок при n = 1 має знак "+"
        } else {
            // Кожен наступний доданок змінює знак, множиться на a і ділиться на n
            term = -term * a / n; 
        }
        S += term; // Додаємо поточний член до загальної суми
    }

    // 3. Виведення результату
    printf("Сумма ряду S = %.6lf\n", S);

    return 0;
}
